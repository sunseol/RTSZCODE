# ==========================================================
#  역전(歷戰) — 환경 변수 예시
#  실제 값은 .env.local 에 넣고 커밋하지 마세요 (.gitignore 확인)
# ==========================================================

# 사이트 정식 URL (SEO 의 핵심 — OG, sitemap, robots, canonical 모두 여기 기준)
# 반드시 배포 도메인으로 설정. 예: https://yeokjeon.com
NEXT_PUBLIC_SITE_URL=https://medieval-rts.vercel.app

# ---------- Zalo 로그인 (필수) ----------
# Zalo Developers > 애플리케이션 > 설정에서 발급
ZALO_APP_ID=
ZALO_APP_SECRET=

# Zalo Developers > 애플리케이션 > 로그인 > Web Callback URL과 정확히 일치
ZALO_REDIRECT_URI=https://medieval-rts.vercel.app/api/auth/zalo/callback

# 세션 서명용 32자 이상 비밀값. 예: openssl rand -base64 32
AUTH_SECRET=

# 해외 서버에서 Zalo 프로필 API가 -501을 반환할 때 사용하는 베트남 HTTP(S) 프록시
# 서버 전용 비밀값이며 NEXT_PUBLIC_ 접두사를 붙이거나 저장소에 실제 값을 커밋하지 마세요.
ZALO_PROXY_URL=

# ---------- 분석 / 트래킹 (선택) ----------
# GA4 측정 ID (G-xxxxxxxxxx). 비우면 GA 스크립트 미출력.
NEXT_PUBLIC_GA_ID=

# 네이버 비즈니스 이벤트 추적용 script key (GFA). 비우면 미출력.
NEXT_PUBLIC_NAVER_GFA_KEY=
